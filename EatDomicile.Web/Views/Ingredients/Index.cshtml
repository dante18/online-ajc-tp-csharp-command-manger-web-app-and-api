@using EatDomicile.Web.ViewsModels.Ingredients
@model IngredientListViewModel

@{
    ViewData["Title"] = "Ingredients";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="row">
        <div class="col-12 d-flex align-items-center justify-content-center">
            <div class="alert alert-danger">
                @TempData["ErrorMessage"]
            </div>
        </div>
    </div>
}

<div class="row">
    <div class="col-6 d-flex align-items-center justify-content-start">
        <h1>Liste des ingrédients</h1>
    </div>
    <div class="col-6 d-flex align-items-center justify-content-end">
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary">Ajouter un ingrédient</a>
        }
    </div>
</div>
<div class="row">
    <div class="col-12 table-responsive mt-3">
        <table class="table table-bordered table-striped">
            <thead>
            <tr>
                <th class="text-center">Nom</th>
                <th class="text-center">Allergène</th>
                <th class="text-center">KCal</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var ingredient in Model.Items)
            {
                <tr>
                    <td class="text-center">@ingredient.Name</td>
                    <td class="text-center">@ingredient.KCal</td>
                    <td class="text-center">@(ingredient.IsAllergen ? "Oui" : "Non")</td>
                    <td class="text-center">
                        <a asp-action="Details" asp-route-id="@ingredient.Id" class="btn btn-info">Détail</a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@ingredient.Id" class="btn btn-warning">Modifier</a>
                            <a asp-action="Delete" asp-route-id="@ingredient.Id" class="btn btn-danger">Supprimer</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
@if (Model.maxPage > 1)
{
    <div class="row">
        <div class="col-12">
            <nav aria-label="Page navigation example">
                <ul class="pagination justify-content-center">
                    @if (Model.currentPage == 1)
                    {
                        <li class="page-item disabled"><span class="page-link">Previous</span></li>
                    }
                    else
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.previousPage)">Précédent</a>
                        </li>
                    }
                    @foreach (var i in Enumerable.Range(1, Model.maxPage))
                    {
                        if (i == Model.currentPage)
                        {
                            <li class="page-item active"><span class="page-link">@i</span></li>
                        }
                        else
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                            </li>
                        }
                    }
                    @if (Model.currentPage == Model.maxPage)
                    {
                        <li class="page-item disabled"><span class="page-link">Next</span></li>
                    }
                    else
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.nextPage)">Next</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
}