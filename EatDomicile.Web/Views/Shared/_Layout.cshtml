<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EatDomicile | @ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EatDomicile.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @if (this.User.Identity!.IsAuthenticated)
    {
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                <div class="container-fluid">
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">EatDomicile</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">Accueil</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link  @(ViewContext.RouteData.Values["controller"]?.ToString() == "Drinks" ? "active" : "")" asp-area="" asp-controller="Drinks" asp-action="Index">Boissons</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link  @(ViewContext.RouteData.Values["controller"]?.ToString() == "Ingredients" ? "active" : "")" asp-area="" asp-controller="Ingredients" asp-action="Index">Ingrédients</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link  @(ViewContext.RouteData.Values["controller"]?.ToString() == "Doughs" ? "active" : "")" asp-area="" asp-controller="Doughs" asp-action="Index">Pâtes</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link  @(ViewContext.RouteData.Values["controller"]?.ToString() == "Pizzas" ? "active" : "")" asp-area="" asp-controller="Pizzas" asp-action="Index">Pizzas</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link  @(ViewContext.RouteData.Values["controller"]?.ToString() == "Burgers" ? "active" : "")" asp-area="" asp-controller="Burgers" asp-action="Index">Burgers</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link  @(ViewContext.RouteData.Values["controller"]?.ToString() == "Pastas" ? "active" : "")" asp-area="" asp-controller="Pastas" asp-action="Index">Pastas</a>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link  @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")" asp-area="" asp-controller="Users" asp-action="Index">Utilisateurs</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link  @(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" ? "active" : "")" asp-area="" asp-controller="Orders" asp-action="Index">Commandes</a>
                                </li>
                            }
                            @if (this.User.Identity!.IsAuthenticated)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        @(this.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value)
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <form asp-controller="Security" asp-action="Logout" method="post" class="d-inline">
                                                <button type="submit" class="dropdown-item">Déconnexion</button>
                                            </form>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Security" asp-action="Login">Connexion</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Security" asp-action="Register">Inscription</a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
    }

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @if (this.User.Identity!.IsAuthenticated)
    {
        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2025 - EatDomicile - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </footer>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
